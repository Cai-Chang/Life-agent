FROM python:3.13.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock \
    && useradd --create-home --uid 10001 lifeagent
COPY --chown=lifeagent:lifeagent backend/ ./
USER lifeagent
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "lifeagent.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
